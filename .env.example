# ============================================================================
# InstaFlow — Exemplo de configuração de ambiente
# Copie para ".env" e ajuste. Todas as opções têm defaults seguros.
# ============================================================================

# --- Ambiente ---------------------------------------------------------------
# development | production
ENVIRONMENT=development
# Logs detalhados (padrão: true fora de produção)
# DEBUG=false

# --- Servidor ---------------------------------------------------------------
PORT=8000
APP_TZ=America/Sao_Paulo

# --- Segurança (IMPORTANTE em produção) -------------------------------------
# Chave mestra usada para criptografar credenciais do Instagram e assinar dados.
# DEFINA um valor longo e aleatório em produção e NUNCA compartilhe.
# Gere com:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Domínios permitidos no CORS (separados por vírgula). Vazio = libera tudo (*),
# aceitável só fora de produção.
# CORS_ORIGINS=https://seuapp.com,https://www.seuapp.com

# Expiração da sessão de login em dias (0 = nunca expira)
SESSION_TTL_DAYS=30

# Política de senha do usuário do painel
MIN_PASSWORD_LENGTH=8

# Proteção anti-força-bruta no login
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCKOUT_MINUTES=15

# Criar conta automaticamente no primeiro login (padrão: desligado/seguro)
ALLOW_LOGIN_AUTOCREATE=false

# Exigir verificação de e-mail antes de permitir login
REQUIRE_EMAIL_VERIFICATION=false

# --- Banco de dados ---------------------------------------------------------
# SQLite (padrão) ou PostgreSQL para produção/escala:
# DATABASE_URL=postgresql://usuario:senha@host:5432/instaflow
# DATABASE_URL=sqlite:///./data/app.db

# Diretório de dados (mídias, sessões, banco SQLite)
# DATA_DIR=./data

# --- Uploads ----------------------------------------------------------------
MAX_UPLOAD_MB=500

# --- Automação --------------------------------------------------------------
POSTING_WORKERS=8
CODE_TIMEOUT=180

# Tentativas automáticas em falhas transitórias de rede
NETWORK_RETRY_ATTEMPTS=3
NETWORK_RETRY_BACKOFF=5

# Limite anti-ban de postagens por conta a cada 24h
MAX_POSTS_PER_DAY=25

# Retenção de logs de postagem em dias (0 = manter para sempre)
LOG_RETENTION_DAYS=90

# Health-check automático de contas em minutos (0 = desligado)
ACCOUNT_HEALTHCHECK_MINUTES=0

# --- E-mail (SMTP) para envio real de códigos -------------------------------
# Sem SMTP configurado, o código aparece na tela (modo fallback).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=seu-email@gmail.com
# SMTP_PASSWORD=sua-senha-de-app
# SMTP_FROM=InstaFlow <noreply@seudominio.com>
